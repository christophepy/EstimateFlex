[MASTER]
extension-pkg-whitelist=PyQt6

[TYPECHECK]
extension-pkg-allow-list=
    PyQt6.QtCore,
    PyQt6.QtGui,
    PyQt6.QtWidgets

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-instance-attributes,
    duplicate-code,
    broad-exception-caught,
    invalid-name,
    protected-access
